---
import Title from './Title.astro'
import { Image } from 'astro:assets'

const faviconUrl = new URL('/blog/favicon.png', Astro.url).href
type Props = {
	title: string
}

const { title } = Astro.props
---

<div class='flex justify-start items-center gap-2 title'>
	<Image src={faviconUrl} width={50} height={50} format='png' alt={`img of ${title}`} />
	<Title>{title}</Title>
</div>
