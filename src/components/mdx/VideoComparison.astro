---
export interface Props {
	leftVideo: {
		src: string
		title: string
		description: string
	}
	rightVideo: {
		src: string
		title: string
		description: string
	}
}

const { leftVideo, rightVideo } = Astro.props
---

<div class='video-comparison-container my-8'>
	<div class='grid grid-cols-1 lg:grid-cols-2 gap-6'>
		<!-- Left Video -->
		<div class='video-item'>
			<div class='video-wrapper'>
				<iframe
					width='100%'
					height='315'
					src={leftVideo.src}
					title={leftVideo.title}
					frameborder='0'
					allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
					referrerpolicy='strict-origin-when-cross-origin'
					allowfullscreen
					class=''></iframe>
			</div>
			<div class='video-description mt-3'>
				<p class='text-xs text-center' style='color: #6b7280;'>
					{leftVideo.description}
				</p>
			</div>
		</div>

		<!-- Right Video -->
		<div class='video-item'>
			<div class='video-wrapper'>
				<iframe
					width='100%'
					height='315'
					src={rightVideo.src}
					title={rightVideo.title}
					frameborder='0'
					allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
					referrerpolicy='strict-origin-when-cross-origin'
					allowfullscreen
					class=''></iframe>
			</div>
			<div class='video-description mt-3'>
				<p class='text-xs text-center' style='color: #6b7280;'>
					{rightVideo.description}
				</p>
			</div>
		</div>
	</div>
</div>

<style>
	.video-comparison-container {
		margin: 2rem 0;
	}

	.video-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16/9;
		overflow: hidden;
	}

	.video-wrapper iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	.video-description p {
		margin: 0;
	}

	@media (max-width: 1024px) {
		.video-comparison-container .grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>
